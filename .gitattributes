# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.spec text eol=lf

# Binary files
*.png binary linguist-vendored
*.gif binary linguist-vendored
*.ico binary linguist-vendored
*.zip binary linguist-vendored
*.dll binary linguist-vendored
*.ttf binary linguist-vendored
*.exe binary linguist-vendored
src/expedition33_rpc/assets/game_data.json linguist-generated
